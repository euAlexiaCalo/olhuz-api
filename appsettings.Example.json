{
  "ConnectionStrings": {

    // Conexão principal utilizada pelo Entity Framework/Core
    // Nome da máquina e instância do SQL Server - Banco de dados da aplicação - uso das credenciais do Windows para autenticação - ignora validações de certificado SSL em ambientes de desenvolvimento
    "DefaultConnection": "Server=LOCALHOST\\SQLEXPRESS;Database=NOME_DO_BANCO;Trusted_Connection=true;TrustServerCertificate=true"
  },

  "Jwt": {
    "Key": "SUA_CHAVE_SECRETA_AQUI_MINIMO_32_CARACTERES", // Chave secreta usada para assinar e validar o token
    "Issuer": "SUA_APLICACAO", // Emissor do token - nome da aplicação ou serviço responsável por gerar o token
    "Audience": "SEU_CLIENTE", // Destinatário do token - define quais sistemas ou usuários podem utilizar o token gerado
    "ExpireDays": 7 // Tempo de expiração do token
  },

  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com", // Endereço do servidor SMTP responsável pelo envio de emails
    "Port": 587, // Porta utilizada para comunicação com o servidor SMTP
    "SenderName": "NOME_DO_REMETENTE", // Nome exibido como remetente para o destinatário
    "SenderEmail": "seu_email@exemplo.com", // Conta de email utilizada para realizar os envios
    "Password": "SUA_SENHA_DE_APLICATIVO" // Senha do aplicativo utilizada na autenticação SMTP
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*" // Define quais domínios podem acessar a aplicação
}